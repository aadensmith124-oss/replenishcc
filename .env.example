# Required by the API. Keep real values in Replit Secrets or the hosting
# provider's environment settings; never commit them.
DATABASE_URL=
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: enable NOWPayments crypto deposits.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional: comma-separated addresses allowed to manage deposits.
DEPOSIT_ADMIN_EMAILS=